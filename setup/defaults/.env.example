# Optional. Leave empty to use deterministic fallback generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_USE_BY_DEFAULT=true

# Optional. Gmail application communication sync is read-only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8765/connectors/email/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Optional email settings for a later SMTP sender.
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
